{
  "name": "@bemedev/mind-flow",
  "version": "0.0.1",
  "description": "Flow Chart UI library for Solid.js applications",
  "keywords": [
    "diagram",
    "flow",
    "flowchart",
    "solid-js",
    "ui-library"
  ],
  "license": "MIT",
  "author": {
    "name": "chlbri",
    "email": "bri_lvi@icloud.com",
    "url": "https://bemedev.vercel.app"
  },
  "maintainers": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "contributors": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/mind-app"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "main": "lib/index.es.js",
  "module": "lib/index.es.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "pnpm rm:lib && tsc && vite build",
    "build:showroom": "pnpm run build && cd showroom && pnpm run build",
    "ci": "pnpm run config:off && pnpm run lint && pnpm run build && pnpm run test && pnpm run prettier && pnpm run p-q",
    "ci:admin": "pnpm run rm && pnpm run upgrade && pnpm run ci",
    "clean": "pnpm run rm && pnpm run config",
    "config": "pnpm install && cd showroom && pnpm install",
    "config:off": "pnpm run config --offline",
    "dev": "pnpm run build && cd showroom && pnpm run dev",
    "dev:host": "pnpm run build && cd showroom && pnpm run dev:host",
    "eslint": "eslint \"{src/**/*,App}.{ts,tsx}\"",
    "gen:app-ts": "app-typings generate",
    "gen:app-ts:watch": "pnpm run gen:app-ts -w",
    "lint": "pnpm run prettier && pnpm run eslint --fix && cd showroom && pnpm run lint",
    "lint:watch": "onchange --await-write-finish 5500 \"**/*\" -- pnpm run lint",
    "prepublishOnly": "",
    "prepare": "husky",
    "prettier": "prettier --write \"src/**/*.{ts,tsx}\"",
    "p-q": "pretty-quick",
    "rinit": "pnpm run rm && pnpm run config",
    "rinit:off": "pnpm run rm && pnpm run config:off",
    "rimraf": "pnpx rimraf -rf",
    "rm": "pnpm run rimraf -- node_modules pnpm-lock.yaml",
    "rm:lib": "pnpm run rimraf -- lib",
    "size": "size-limit",
    "test": "pnpm run test:coverage --no-coverage",
    "test:coverage": "vitest run",
    "test:watch": "vitest",
    "upgrade": "pnpm upgrade --latest",
    "build:css": "pnpx @tailwindcss/cli -i ./input.css -o ../lib/output.css --minify --cwd ./src",
    "buidl:css:watch": "pnpm run build:css --watch"
  },
  "dependencies": {
    "dequal": "^2.0.3",
    "nanoid": "^6.0.1"
  },
  "devDependencies": {
    "@bemedev/app": "^1.11.0",
    "@bemedev/app-cli": "^1.11.0",
    "@bemedev/app-solidjs": "^1.11.0",
    "@bemedev/fsf": "^1.0.1",
    "@bemedev/rollup-config": "^0.2.2",
    "@bemedev/vitest-alias": "^0.0.3",
    "@bemedev/vitest-exclude": "^0.1.1",
    "@bemedev/vitest-extended": "^1.5.3",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@size-limit/file": "^13.0.3",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@thisbeyond/solid-dnd": "^0.7.5",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-preset-solid": "^1.9.12",
    "eslint": "^10.8.1",
    "glob": "^13.0.6",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "onchange": "^7.1.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "pretty-quick": "^4.2.2",
    "rolldown": "^1.2.4",
    "rollup": "^4.62.4",
    "rollup-preset-solid": "^3.0.0",
    "size-limit": "^13.0.3",
    "solid-js": "^1.9.14",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-solid": "^2.11.14",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@bemedev/app": "^1.10.0",
    "@bemedev/app-solidjs": "^1.10.0",
    "@thisbeyond/solid-dnd": "^0.7.5",
    "solid-js": "^1.9.10"
  },
  "size-limit": [
    {
      "path": "lib/esm/*.js",
      "limit": "50 KB"
    },
    {
      "path": "lib/cjs/*.cjs",
      "limit": "50 KB"
    }
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1"
}
