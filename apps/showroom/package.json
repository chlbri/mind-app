{
  "name": "mind-app-showroom",
  "version": "0.0.1",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @bemedev/mind-flow run build",
    "_build": "vite build",
    "build": "pnpm run _build",
    "pretest": "pnpm run _build",
    "_ci": "pnpm run lint && pnpm run test",
    "ci": "CI_START=$(date +%s) && pnpm run _ci && pnpm run p-q && echo \"\n✅ CI takes $(($(date +%s) - CI_START))s\n\"",
    "dev": "vite dev",
    "dev:host": "pnpm run dev -- --host",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "_lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint": "pnpm run fmt && pnpm run lint:fix",
    "p-q": "pretty-quick",
    "preview": "pnpm run pretest && pnpm run start",
    "start": "vite start",
    "test": "pnpm run test:coverage --no-coverage",
    "test:only": "pnpm run test:coverage --no-coverage",
    "test:coverage": "vitest run",
    "test:watch": "vitest",
    "rm:lib": "pnpx rimraf ./lib",
    "upgrade": "pnpm up --latest"
  },
  "dependencies": {
    "@bemedev/app": "^2.5.0",
    "@bemedev/app-solidjs": "^2.5.1",
    "@bemedev/decompose": "^2.3.0",
    "@bemedev/i18n": "^0.7.0",
    "@bemedev/mind-flow": "workspace:^",
    "@bemedev/pipe": "^1.6.1",
    "@bemedev/sleep": "^0.2.2",
    "@kobalte/core": "^0.13.13",
    "@solid-primitives/intersection-observer": "^2.2.5",
    "@solid-primitives/storage": "^4.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/solid-router": "1.170.30",
    "@tanstack/solid-start": "1.168.47",
    "@thisbeyond/solid-dnd": "^0.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "color": "^5.0.3",
    "dequal": "^2.0.3",
    "lucide-solid": "^1.34.0",
    "nanoid": "^6.0.1",
    "nitro": "3.0.260610-beta",
    "redaxios": "^0.5.1",
    "solid-flow": "^1.0.4",
    "solid-js": "^1.9.15",
    "solid-motionone": "^1.0.4",
    "solidjs-use": "^2.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.4.2",
    "vinxi": "0.5.11"
  },
  "devDependencies": {
    "@bemedev/app-cli": "^2.5.0",
    "@bemedev/dev-utils": "^1.3.1",
    "@solidjs/testing-library": "^0.8.10",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/solid-router-devtools": "1.167.1",
    "@types/node": "^26.4.0",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "glob": "^13.0.6",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "playwright": "^1.62.1",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "4.1.11"
  }
}
