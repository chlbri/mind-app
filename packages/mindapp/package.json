{
  "name": "@bemedev/mind-flow",
  "version": "1.4.0",
  "description": "Flow Chart UI library for Solid.js applications",
  "keywords": [
    "diagram",
    "flow",
    "flowchart",
    "solid-js",
    "ui-library"
  ],
  "license": "MIT",
  "author": {
    "name": "chlbri",
    "email": "bri_lvi@icloud.com",
    "url": "https://bemedev.vercel.app"
  },
  "maintainers": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "node": {
        "import": "./lib/server.es.js",
        "require": "./lib/server.cjs.js"
      },
      "browser": {
        "import": "./lib/index.es.js",
        "require": "./lib/index.cjs.js"
      },
      "import": "./lib/index.es.js",
      "require": "./lib/index.cjs.js"
    },
    "./style.css": "./lib/output.css"
  },
  "contributors": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/mind-app"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "main": "lib/index.es.js",
  "module": "lib/index.es.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "pnpm rm:lib && pnpm run build:dev",
    "build:dev": "pnpm run build:server && pnpm run build:client && pnpm run build:css",
    "build:client": "vite build",
    "build:server": "vite build --mode server",
    "build:css": "pnpx @tailwindcss/cli -i ./input.css -o ../lib/output.css --minify --cwd ./src",
    "build:css:watch": "pnpm run build:css --watch",
    "pretest": "pnpm run build",
    "posttest": "pnpm run size",
    "_ci": "pnpm run lint && pnpm run test",
    "ci": "CI_START=$(date +%s) && pnpm run _ci && pnpm run p-q && echo \"\n✅ CI takes $(($(date +%s) - CI_START))s\n\"",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "_lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint": "pnpm run fmt && pnpm run lint:fix",
    "p-q": "pretty-quick",
    "rm": "pnpx rimraf ./node_modules ./pnpm-lock.yaml",
    "rm:lib": "pnpx rimraf -- lib",
    "size": "size-limit",
    "test": "pnpm run test:coverage --no-coverage",
    "test:only": "pnpm run test:coverage --no-coverage",
    "test:coverage": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dequal": "^2.0.3",
    "nanoid": "^6.0.1"
  },
  "devDependencies": {
    "@bemedev/app": "^2.5.0",
    "@bemedev/app-cli": "^2.5.0",
    "@bemedev/app-solidjs": "^2.5.1",
    "@bemedev/dev-utils": "^1.3.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@size-limit/file": "^13.0.3",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "glob": "^13.0.6",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "onchange": "^7.1.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.6",
    "rollup-preset-solid": "^3.0.0",
    "size-limit": "^13.0.3",
    "solid-js": "^1.9.15",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@bemedev/app": "^2.5.0",
    "@bemedev/app-solidjs": "^2.5.1",
    "@thisbeyond/solid-dnd": "^0.7.5",
    "solid-js": "^1.9.15"
  },
  "size-limit": [
    {
      "path": "lib/index.es.js",
      "limit": "50 KB"
    },
    {
      "path": "lib/index.cjs.js",
      "limit": "50 KB"
    }
  ],
  "engines": {
    "node": ">=22"
  }
}
