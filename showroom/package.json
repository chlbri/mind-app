{
  "name": "mind-app-showroom",
  "version": "0.0.1",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "ci": "pnpm run config:off && pnpm run lint && pnpm run test",
    "config": "pnpm install",
    "config:off": "pnpm run config --offline",
    "dev": "vite dev",
    "dev:host": "pnpm run dev -- --host",
    "eslint": "eslint \"{src/**/*,App}.{ts,tsx}\"",
    "lint": "pnpm run prettier && pnpm run eslint --fix",
    "p-q": "pretty-quick",
    "prepare": "husky",
    "preview": "pnpm run build && vite start",
    "prettier": "prettier --write \"**/*.{ts,tsx}\" --log-level silent",
    "start": "vite start",
    "test": "pnpm run test:coverage --no-coverage",
    "test:coverage": "vitest run",
    "test:watch": "vitest",
    "upgrade": "pnpm up --latest",
    "upgrade:safe": "pnpm run upgrade && pnpm add @tanstack/solid-router@1.133.15 @tanstack/solid-start@1.133.15 && pnpm add -D @tanstack/nitro-v2-vite-plugin@1.133.17 @tanstack/solid-router-devtools@1.133.15"
  },
  "dependencies": {
    "@bemedev/app-solid": "^0.3.0",
    "@bemedev/app-ts": "^1.3.1",
    "@bemedev/decompose": "^1.3.1",
    "@bemedev/fsf": "^1.0.1",
    "@bemedev/i18n": "^0.5.2",
    "@bemedev/mind-flow": "link:..",
    "@bemedev/pipe": "^0.1.0",
    "@bemedev/sleep": "^0.1.2",
    "@kobalte/core": "^0.13.11",
    "@solid-primitives/intersection-observer": "^2.2.2",
    "@solid-primitives/storage": "^4.3.3",
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/solid-router": "1.133.15",
    "@tanstack/solid-start": "1.133.15",
    "@thisbeyond/solid-dnd": "^0.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "color": "^5.0.3",
    "dequal": "^2.0.3",
    "lucide-solid": "^0.554.0",
    "nanoid": "^5.1.6",
    "nitro": "3.0.1-alpha.1",
    "redaxios": "^0.5.1",
    "solid-flow": "^1.0.4",
    "solid-js": "^1.9.10",
    "solid-motionone": "^1.0.4",
    "solidjs-use": "^2.3.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.1.0",
    "vinxi": "0.5.8"
  },
  "devDependencies": {
    "@bemedev/app-cli": "^0.1.7",
    "@bemedev/vitest-alias": "^0.0.3",
    "@bemedev/vitest-exclude": "^0.1.1",
    "@bemedev/vitest-extended": "^1.5.3",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@solidjs/testing-library": "^0.8.10",
    "@tanstack/devtools-vite": "^0.3.11",
    "@tanstack/nitro-v2-vite-plugin": "1.133.17",
    "@tanstack/solid-router-devtools": "1.133.15",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitest/browser-playwright": "4.0.13",
    "@vitest/coverage-istanbul": "^4.0.13",
    "eslint": "^9.39.1",
    "glob": "^13.0.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "npm:rolldown-vite@^7.2.7",
    "vite-plugin-solid": "^2.11.10",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "4.0.13"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@latest"
  }
}
