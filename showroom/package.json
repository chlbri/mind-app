{
  "name": "mind-app-showroom",
  "version": "0.0.1",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:libs": "cd .. && pnpm run build && cd showroom && vite build",
    "ci": "pnpm run config:off && pnpm run lint && pnpm run test",
    "config": "pnpm install",
    "config:off": "pnpm run config --offline",
    "dev": "vite dev",
    "dev:host": "pnpm run dev -- --host",
    "eslint": "eslint \"{src/**/*,App}.{ts,tsx}\"",
    "lint": "pnpm run prettier && pnpm run eslint --fix",
    "p-q": "pretty-quick",
    "prepare": "husky",
    "preview": "pnpm run build && vite start",
    "prettier": "prettier --write \"**/*.{ts,tsx}\" --log-level silent",
    "start": "vite start",
    "test": "pnpm run test:coverage --no-coverage",
    "test:coverage": "vitest run",
    "test:watch": "vitest",
    "upgrade": "pnpm up --latest",
    "upgrade:safe": "pnpm run upgrade && pnpm add @tanstack/solid-router@1.133.15 @tanstack/solid-start@1.133.15 && pnpm add -D @tanstack/nitro-v2-vite-plugin@1.133.17 @tanstack/solid-router-devtools@1.133.15"
  },
  "dependencies": {
    "@bemedev/app": "^1.10.0",
    "@bemedev/app-solidjs": "^1.10.0",
    "@bemedev/decompose": "^2.2.0",
    "@bemedev/fsf": "^1.0.1",
    "@bemedev/i18n": "^0.5.7",
    "@bemedev/mind-flow": "link:..",
    "@bemedev/pipe": "^1.6.1",
    "@bemedev/sleep": "^0.2.2",
    "@kobalte/core": "^0.13.11",
    "@solid-primitives/intersection-observer": "^2.2.4",
    "@solid-primitives/storage": "^4.3.4",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/solid-router": "1.170.9",
    "@tanstack/solid-start": "1.168.16",
    "@thisbeyond/solid-dnd": "^0.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "color": "^5.0.3",
    "dequal": "^2.0.3",
    "lucide-solid": "^1.17.0",
    "nanoid": "^5.1.16",
    "nitro": "3.0.260522-beta",
    "redaxios": "^0.5.1",
    "solid-flow": "^1.0.4",
    "solid-js": "^1.9.13",
    "solid-motionone": "^1.0.4",
    "solidjs-use": "^2.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.4.1",
    "vinxi": "0.5.11"
  },
  "devDependencies": {
    "@bemedev/app-cli": "^0.2.2",
    "@bemedev/vitest-alias": "^0.0.3",
    "@bemedev/vitest-exclude": "^0.1.1",
    "@bemedev/vitest-extended": "^1.5.3",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@solidjs/testing-library": "^0.8.10",
    "@tanstack/devtools-vite": "^0.7.0",
    "@tanstack/nitro-v2-vite-plugin": "1.155.0",
    "@tanstack/solid-router-devtools": "1.167.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/browser-playwright": "4.1.7",
    "@vitest/coverage-istanbul": "^4.1.7",
    "eslint": "^10.4.1",
    "glob": "^13.0.6",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-solid": "^2.11.12",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "4.1.7"
  }
}
